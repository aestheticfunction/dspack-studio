{
  "name": "@dspack-studio/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "The Astryx dspack contract, its A2UI mapping profile, gated catalog emission, and the Astryx vocabulary drift check.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./astryx.dspack.json": "./astryx.dspack.json",
    "./out/*": "./out/*",
    "./shadcn-ui.dspack.json": "./shadcn-ui.dspack.json"
  },
  "scripts": {
    "build:catalogs": "tsx src/build.ts",
    "prepare": "pnpm run build:catalogs",
    "drift-check": "tsx src/drift-check.ts",
    "check:sync": "node scripts/check-sync.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aestheticfunction/dspack-emit": "0.4.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.4",
    "@astryxdesign/core": "0.1.4",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
