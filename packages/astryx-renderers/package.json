{
  "name": "@dspack-studio/astryx-renderers",
  "version": "0.1.0",
  "private": true,
  "description": "The visual layer: maps every component name in the emitted Astryx A2UI catalog to a real @astryxdesign/core component, tagged with data-a2ui-id for X-ray provenance. The one package (with a2ui-ingest) allowed to import @a2ui/*.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.4",
    "@astryxdesign/theme-butter": "0.1.4",
    "@astryxdesign/theme-chocolate": "0.1.4",
    "@astryxdesign/theme-gothic": "0.1.4",
    "@astryxdesign/theme-matcha": "0.1.4",
    "@astryxdesign/theme-neutral": "0.1.4",
    "@astryxdesign/theme-stone": "0.1.4",
    "@astryxdesign/theme-y2k": "0.1.4",
    "@dspack-studio/a2ui-ingest": "workspace:*",
    "@stylexjs/stylex": "^0.18.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
