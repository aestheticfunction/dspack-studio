{
  "dspackSurface": "0.1",
  "system": "shadcn/ui",
  "intent": "structured-input",
  "root": {
    "component": "form",
    "props": {
      "control": "form.control",
      "handleSubmit": "form.handleSubmit(onSubmit)"
    },
    "children": [
      {
        "component": "form-field",
        "children": [
          {
            "component": "form-item",
            "children": [
              {
                "component": "form-label",
                "text": "Merchant"
              },
              {
                "component": "form-control",
                "children": [
                  {
                    "component": "input",
                    "props": {
                      "type": "text",
                      "placeholder": "Where the expense was incurred"
                    }
                  }
                ]
              },
              {
                "component": "form-description",
                "text": "Use the name printed on the receipt, not the parent company."
              },
              {
                "component": "form-message"
              }
            ]
          }
        ]
      },
      {
        "component": "form-field",
        "children": [
          {
            "component": "form-item",
            "children": [
              {
                "component": "form-label",
                "text": "Amount in USD"
              },
              {
                "component": "form-control",
                "children": [
                  {
                    "component": "input",
                    "props": {
                      "type": "number",
                      "placeholder": "0.00"
                    }
                  }
                ]
              },
              {
                "component": "form-message"
              }
            ]
          }
        ]
      },
      {
        "component": "form-field",
        "children": [
          {
            "component": "form-item",
            "children": [
              {
                "component": "form-label",
                "text": "Date of purchase"
              },
              {
                "component": "form-control",
                "children": [
                  {
                    "component": "input",
                    "props": {
                      "type": "date"
                    }
                  }
                ]
              },
              {
                "component": "form-description",
                "text": "Expenses older than 90 days need a manager's note."
              },
              {
                "component": "form-message"
              }
            ]
          }
        ]
      },
      {
        "component": "form-field",
        "children": [
          {
            "component": "form-item",
            "children": [
              {
                "component": "form-label",
                "text": "Reimbursement method"
              },
              {
                "component": "form-control",
                "children": [
                  {
                    "component": "radio-group",
                    "props": {
                      "name": "reimbursement",
                      "defaultValue": "payroll"
                    },
                    "children": [
                      {
                        "component": "radio-group-item",
                        "id": "reimbursement-payroll"
                      },
                      {
                        "component": "label",
                        "props": {
                          "htmlFor": "reimbursement-payroll"
                        },
                        "text": "Add to the next payroll run"
                      },
                      {
                        "component": "radio-group-item",
                        "id": "reimbursement-transfer"
                      },
                      {
                        "component": "label",
                        "props": {
                          "htmlFor": "reimbursement-transfer"
                        },
                        "text": "Bank transfer within five working days"
                      }
                    ]
                  }
                ]
              },
              {
                "component": "form-description",
                "text": "Contractors must choose bank transfer; payroll is unavailable to them."
              },
              {
                "component": "form-message"
              }
            ]
          }
        ]
      },
      {
        "component": "form-field",
        "children": [
          {
            "component": "form-item",
            "children": [
              {
                "component": "form-label",
                "text": "Business purpose"
              },
              {
                "component": "form-control",
                "children": [
                  {
                    "component": "textarea",
                    "props": {
                      "name": "purpose",
                      "rows": 4,
                      "placeholder": "Who the expense was for and why it was necessary"
                    }
                  }
                ]
              },
              {
                "component": "form-description",
                "text": "Required for anything over $75."
              },
              {
                "component": "form-message"
              }
            ]
          }
        ]
      },
      {
        "component": "form-field",
        "children": [
          {
            "component": "form-item",
            "children": [
              {
                "component": "form-label",
                "text": "Billable to a client"
              },
              {
                "component": "form-control",
                "children": [
                  {
                    "component": "checkbox",
                    "props": {
                      "name": "billable"
                    }
                  }
                ]
              },
              {
                "component": "form-description",
                "text": "Billable expenses appear on the client's next invoice."
              },
              {
                "component": "form-message"
              }
            ]
          }
        ]
      },
      {
        "component": "button",
        "props": {
          "variant": "outline"
        },
        "text": "Save draft"
      },
      {
        "component": "button",
        "text": "Submit for approval"
      }
    ]
  }
}