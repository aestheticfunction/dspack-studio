            "type": "object",
            "props": [
              {
                "name": "id",
                "type": "string",
                "required": true,
                "minLength": 1,
                "maxLength": 40
              },
              {
                "name": "name",
                "type": "string",
                "required": true,
                "minLength": 1,
                "maxLength": 60
              },
              {
                "name": "area",
                "type": "string",
                "required": true,
                "minLength": 1,
                "maxLength": 60
              },
              {
                "name": "price",
                "type": "integer",
                "required": true,
                "minimum": 1,
                "maximum": 5000
              },
              {
                "name": "rating",
                "type": "string",
                "required": true,
                "minLength": 1,
                "maxLength": 20
              }
            ]
          }
        },
        {
          "name": "selection",
          "type": "object",
          "props": [
            {
              "name": "id",
              "type": "string",
              "required": true,
              "minLength": 1,
              "maxLength": 40
            },
            {
              "name": "name",
              "type": "string",
              "required": true,
              "minLength": 1,
              "maxLength": 60
            },
            {
              "name": "total",
              "type": "integer",
              "required": true,
              "minimum": 1,
              "maximum": 150000
            }
          ]
        }
      ],
      "inputs": [
        {
          "name": "destination",
          "node": "new-destination",
          "kind": "text",
          "required": true,
          "minLength": 2,
          "maxLength": 80
        }
      ],
      "actions": [
        {
          "name": "choose",
          "node": "choose",
          "states": [
            "ready"
          ],
          "repeat": {
            "list": "results",
            "each": "hotels",
            "as": "hotel",
            "witness": [
              "hotel.name"
            ]
          },
          "payload": {
            "hotelId": {
              "$prop": "hotel.id"
            }
          }
        },
        {
          "name": "new_search",
          "node": "new-search",
          "states": [
            "ready"
          ]
        },
        {
          "name": "search_again",
          "node": "search-again",
          "states": [
            "empty"
          ],
          "carries": [
            "destination"
          ]
        },
        {
          "name": "reserve",
          "node": "reserve",
          "states": [
            "confirm"
          ],
          "payload": {
            "hotelId": {
              "$prop": "selection.id"
            }
          },
          "consequential": true
        },
        {
          "name": "back",
          "node": "back",
          "states": [
            "confirm"
          ]
        }
      ],
      "states": [
        {
          "id": "confirm",
          "purpose": "destructive-action",
          "guard": {
            "present": "selection"
