              },
              {
                "component": "text-input",
                "id": "check-in",
                "props": {
                  "label": "Check-in date",
                  "placeholder": "YYYY-MM-DD"
                }
              },
              {
                "component": "text-input",
                "id": "check-out",
                "props": {
                  "label": "Check-out date",
                  "placeholder": "YYYY-MM-DD"
                }
              },
              {
                "component": "text-input",
                "id": "guests",
                "props": {
                  "label": "Guests",
                  "placeholder": "1 to 8"
                }
              },
              {
                "component": "text-input",
                "id": "member-number",
                "props": {
                  "label": "Loyalty number (optional)",
