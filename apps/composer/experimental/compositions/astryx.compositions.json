    {
      "id": "hotel-search",
      "version": 1,
      "status": "approved",
      "name": "Hotel search",
      "summary": "Asks where and when to stay, and for how many guests, and submits the search.",
      "parameters": [
        {
          "name": "title",
          "type": "string",
          "maxLength": 60
        }
      ],
      "data": [
        {
          "name": "errors",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      ],
      "inputs": [
        {
          "name": "destination",
          "node": "destination",
          "kind": "text",
          "required": true,
          "minLength": 2,
          "maxLength": 80
        },
        {
          "name": "checkIn",
          "node": "check-in",
          "kind": "date",
          "required": true,
          "maxLength": 10
        },
        {
          "name": "checkOut",
          "node": "check-out",
          "kind": "date",
          "required": true,
          "maxLength": 10
        },
        {
          "name": "guests",
          "node": "guests",
          "kind": "integer",
          "required": true,
          "minimum": 1,
          "maximum": 8,
          "maxLength": 2
        },
        {
          "name": "memberNumber",
          "node": "member-number",
          "kind": "text",
          "maxLength": 20,
          "sensitive": true
        }
      ],
      "actions": [
        {
          "name": "search",
          "node": "search",
          "states": [
            "invalid",
            "ready"
          ],
          "carries": [
            "destination",
            "checkIn",
            "checkOut",
            "guests",
            "memberNumber"
          ]
        }
      ],
      "states": [
        {
          "id": "invalid",
          "purpose": "data-collection",
          "guard": {
            "present": "errors"
          },
          "template": {
            "component": "card",
            "children": [
              {
                "component": "text",
                "props": {
                  "type": "display-2"
                },
                "text": {
                  "$prop": "title",
                  "default": "Find a hotel"
                }
              },
              {
                "component": "text",
                "props": {
                  "type": "supporting"
                },
                "text": "Some details need another look:"
              },
              {
                "$each": "errors",
                "as": "error",
                "children": [
                  {
                    "component": "text",
                    "props": {
                      "type": "body"
                    },
                    "text": {
                      "$prop": "error"
                    }
                  }
                ]
              },
              {
                "component": "text-input",
                "id": "destination",
                "props": {
                  "label": "Destination",
                  "placeholder": "City or area"
                }
              },
              {
                "component": "text-input",
                "id": "check-in",
                "props": {
                  "label": "Check-in date",
                  "placeholder": "YYYY-MM-DD"
                }
              },
              {
                "component": "text-input",
                "id": "check-out",
                "props": {
                  "label": "Check-out date",
                  "placeholder": "YYYY-MM-DD"
                }
              },
              {
                "component": "text-input",
                "id": "guests",
                "props": {
                  "label": "Guests",
                  "placeholder": "1 to 8"
                }
              },
              {
                "component": "text-input",
                "id": "member-number",
                "props": {
                  "label": "Loyalty number (optional)",
                  "placeholder": "Not kept after this step"
                }
              },
              {
                "component": "button",
                "id": "search",
                "props": {
                  "label": "Search hotels",
                  "variant": "primary"
                }
              }
            ]
          }
        },
        {
          "id": "ready",
          "purpose": "data-collection",
          "guard": {
            "always": true
          },
          "template": {
            "component": "card",
            "children": [
              {
