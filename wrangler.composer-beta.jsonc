// Cloudflare Workers Static Assets: the BETA composer
// (composer-beta.aesthetic-function.com), a separate Worker that serves the
// EXPERIMENTAL artifact, apps/composer/out-experimental (interface blocks,
// docs/blocks/PHASE-2-RELEASE-PLAN.md §6; docs/deployment.md, "The beta
// composer"). Build it with `pnpm --filter composer build:experimental`.
//
// Deployed ONLY by the dispatched deploy-composer-beta workflow, from main,
// through the protected composer-beta environment. Never connect this Worker to
// Workers Builds: that integration reads ./wrangler.jsonc, production's config.
// Production and the beta deploy and roll back independently.
//
// Cloudflare Access protects the custom domain, and only it:
// - workers_dev and preview_urls are off, so no workers.dev or preview URL
//   bypasses Access;
// - keep_vars keeps the switches set in the dashboard, and this file declares
//   no vars: BLOCKS_BETA (the block switch, apps/composer/worker/blocks-beta.mjs)
//   and HOSTED_AI (the kill switch; absent means on) live only in the dashboard,
//   so a deploy never resets either.
//
// Same Worker code and runtime as production: GET /api/models, POST /api/propose
// through the shared ds-ai-gateway, every other request to the asset layer.
{
  "name": "dspack-studio-composer-beta",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "apps/composer/worker/index.mjs",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "composer-beta.aesthetic-function.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./apps/composer/out-experimental",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The shared ds-ai-gateway, as production uses it (worker/propose.mjs). The
  // Cloudflare daily spend limit ($10, auto top-up off) bounds both Workers.
  "ai": { "binding": "AI" },
  // Its own namespace, so beta traffic never counts against production's
  // per-client limit (which does not enforce on this account yet; see
  // wrangler.jsonc and docs/deployment.md).
  "ratelimits": [
    { "name": "PROPOSE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}
