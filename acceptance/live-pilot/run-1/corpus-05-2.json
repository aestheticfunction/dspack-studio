 },
 "goal": "A Convert Estimate to Project workflow.\nStart with a summary of the selected estimate so the user can verify\nwhich estimate will be converted.\nShow the project information required for conversion in a focused\nform, including relevant deadline, recipient, reference,\napplication/publication, or other fields when they are part of the\nsupplied request data.\nClearly separate information inherited from the estimate from\ninformation the user is supplying for the new project.\nBefore conversion, show a review step explaining that this action will\ncreate a project from the estimate.\nRequire explicit confirmation with Cancel and Confirm Conversion actions.\nAfter conversion succeeds, transition directly to the resulting\nProject detail interface. Make the new project identifier and status\nprominent and show that the project was successfully read back from\nGateway.\nThe workflow should visually communicate:\nEstimate → conversion details → review → confirmation → project\ncreated → project verified.",
 "reference": "astryx",
 "startedAt": "2026-11-25T22:36:22.024Z",
 "taskFit": {
  "marked": false,
  "items": [
   "a summary of the estimate being converted",
   "an explicit confirmation before the change",
   "the change cannot be repeated by accident",
   "a read-back of the result",
   "as EXPECTED.md row 5 describes"
  ]
 },
 "flowPlan": {
  "source": "model",
  "raw": {
   "name": "Convert Estimate to Project",
   "steps": [
    {
     "title": "Review Estimate",
     "goal": "Display the selected estimate's summary with key details so the user can verify they are converting the correct estimate.",
     "intent": "record-collection"
    },
    {
     "title": "Enter Project Details",
     "goal": "Collect required project information such as deadline, recipient, reference, and application/publication, with inherited estimate fields clearly distinguished from new user inputs.",
     "intent": "data-collection"
    },
    {
     "title": "Review Conversion",
     "goal": "Present a summary of the conversion action, showing which estimate will become a project and what project details will be created.",
     "intent": "transactional-review"
    },
    {
     "title": "Confirm Conversion",
     "goal": "Require explicit user confirmation with Cancel and Confirm Conversion actions before the irreversible conversion operation proceeds.",
     "intent": "destructive-action"
    },
    {
     "title": "Project Created",
     "goal": "Display the newly created project with its identifier and status prominently, confirming successful conversion and read-back from Gateway.",
     "intent": "structured-editing"
    }
   ]
  },
